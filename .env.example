# Copy to .env and fill in keys for any providers you want to use.
# The app/CLI can also take keys directly (sidebar or --model).

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Groq (Llama / open models, fast, free tier) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=gsk_...

# Default model. The prefix selects the provider.
#   anthropic/claude-sonnet-4-5
#   openai/gpt-4o-mini             (cheap default)
#   openai/gpt-4o                  (more capable)
#   groq/llama-3.3-70b-versatile   (recommended for Groq — best tool use)
#   groq/llama-3.1-8b-instant      (fastest, highest free rate limit)
MODEL=anthropic/claude-sonnet-4-5

# Where models/reports are written.
ARTIFACT_DIR=artifacts
